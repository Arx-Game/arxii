# EDIT BOTH: this file's site-block shape (ws/static/proxy routes, headers)
# must stay in lockstep with Caddyfile.j2 — they are the same site, two
# different ACME strategies. Managed by Ansible (caddy), rehearsal mode only
# (caddy_rehearsal_mode: true).
#
# Rehearsal cannot do ACME/DNS-01: the ephemeral-stage root has NO Cloudflare
# credential (isolation doctrine, #2236 §4.8 — a rehearsal stage box must
# never hold a prod-adjacent token) and the fqdn is a fake, unroutable
# hostname resolved via /etc/hosts on the box itself, so no real CA could
# ever issue for it anyway. `local_certs` makes Caddy its own internal CA —
# no network, no token, no real DNS required. Smoke tests run with curl's
# `-k`/`--insecure` (or `--cacert` against Caddy's exported internal root,
# if ever wired) to accept the internal-CA leaf. See infra/README.md's
# "Dress rehearsal" section for the full list of what this deliberately does
# NOT prove (real ACME issuance, real DNS, R2 offsite — all first-prod-run
# residual risks).
{
	local_certs
	email {{ caddy_acme_email }}
}

{{ caddy_web_fqdn }} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@ws path /ws/*

	# handle blocks are mutually exclusive and evaluated in the order
	# written (unlike bare directives, which Caddy re-orders automatically —
	# unsafe once a block mixes multiple reverse_proxy/file_server targets).
	handle @ws {
		# Evennia portal websocket, localhost-bound. Templated as a single
		# whole-address token exactly like the plain-handle block's
		# caddy_backend below — CI's validate.yml stubs each entire Jinja
		# substitution with a unique placeholder hostname before running
		# caddy adapt, and a bare hostname is a valid reverse_proxy upstream
		# on its own, so this survives that stub.
		reverse_proxy {{ caddy_ws_backend }} {
			# No Cloudflare in front during rehearsal — smoke.sh runs ON the
			# stage box itself (over SSH, host_firewall's Cloudflare-only
			# 80/443 rule only exempts loopback), so {remote_host} here is
			# always 127.0.0.1. Kept for parity with Caddyfile.j2 rather than
			# hand-special-cased; harmless when it's always loopback.
			header_up X-Real-IP {header.CF-Connecting-IP}
		}
	}

	# STATIC_ROOT doesn't itself contain a "static/" subdirectory (collect
	# static populates it flat), so handle_path strips the /static prefix
	# before file_server resolves it against caddy_static_root.
	handle_path /static/* {
		root * {{ caddy_static_root }}
		file_server
	}

{% if caddy_archive_enabled | bool %}
	# --- Arx I static archive (#3320, ADR-0232) -------------------------
	# Read-only historical pages exported from the Arx I sqlite DB
	# (docs/operations/arx1-archival.md), served straight from disk. It
	# lives on THIS vhost, at a path, rather than on its own subdomain
	# precisely so the Arx II session cookie reaches it without
	# SESSION_COOKIE_DOMAIN having to be widened to every subdomain.
	#
	# handle_path, not handle: it strips the prefix before file_server
	# resolves the path, so caddy_archive_root stays the exported tree's
	# own root. The archive's HTML is rewritten to carry this prefix on
	# its root-relative links by the arx1_archive sync role - the two
	# MUST agree, and acceptance.sh asserts they do.
	#
	# The prefix is a LITERAL here, not a templated var, on purpose: CI's
	# validate.yml stubs every whole `{{ ... }}` with a placeholder
	# HOSTNAME before `caddy adapt`, and a path matcher that does not
	# start with "/" is a parse error - a templated prefix would fail
	# validation as a stub artifact. See roles/arx1_archive for the other
	# half of the contract.
	#
	# The static block comes first and is deliberately ungated: css and
	# js reveal nothing, and sparing them the subrequest keeps a page
	# load to one authorization round trip instead of dozens.
	handle_path /arxmush-archive/static/* {
		header X-Robots-Tag "noindex, nofollow"
		root * {{ caddy_archive_root }}/static
		file_server
	}

	handle_path /arxmush-archive/* {
		header X-Robots-Tag "noindex, nofollow"
		# Django answers 200 / 403 / 302-to-login and serves no bytes.
		# forward_auth returns any non-2xx to the client verbatim, so the
		# 302 is what sends a logged-out reader to the SPA login page.
		forward_auth {{ caddy_backend }} {
			uri /api/arx1-archive/authorize/
			copy_headers Cookie
		}
		root * {{ caddy_archive_root }}
		file_server
	}
{% endif %}

	handle {
		reverse_proxy {{ caddy_backend }} {
			header_up X-Real-IP {header.CF-Connecting-IP}
		}
	}
}
{% if caddy_archive_redirect_enabled | bool %}

# Arx I archive, legacy address — kept in lockstep with Caddyfile.j2 (see
# its block comment). Never actually rendered in rehearsal:
# caddy_archive_redirect_enabled is hard-false there (its defaults expression
# includes `not caddy_rehearsal_mode`, and the stage box has no archive fqdn
# anyway — prod-adjacent, by the isolation doctrine). Present so the two
# templates stay the same site set, and CI's validate.yml (which drops
# control-flow lines before adapt) still validates this block's shape against
# the stock binary. The archive moved onto the web vhost at
# /arxmush-archive (#3320, ADR-0232 — superseding ADR-0225's
# "no backend, no Django" isolation property); this block only keeps the
# links already handed out alive. No basic_auth: there is no shared
# credential any more, and the target does its own per-account check.
# Jinja control-flow lines in this template must sit ALONE on their own
# lines — CI's validate.yml drops such lines wholesale before `caddy
# adapt`, so this block is always validated. (`| bool` is load-bearing:
# the folded expression renders as the STRING "True"/"False" — see
# roles/caddy/defaults/main.yml.)
{{ caddy_archive_fqdn }} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	redir https://{{ caddy_web_fqdn }}/arxmush-archive{uri} permanent
}
{% endif %}
