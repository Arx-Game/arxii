#!/usr/bin/env bash
# Managed by Ansible (app_deploy). Portal-crash watchdog.
#
# Type=forking + PIDFile=portal.pid (arxii.service.j2) supervises the Portal, so
# a Server that dies leaves the unit "active" (#4999). Evennia runs Server +
# Portal as two SEPARATE processes (server.pid + portal.pid; see
# src/server/README.md). This timer-driven script checks BOTH pidfiles every run.
# A dead Server under a live Portal is recovered without dropping players (see
# "Server-only recovery" below); any other half-dead state restarts the unit and
# fires an off-box alert. Since the 2026-08-17 reboot outage it also resurrects a
# unit that systemd has parked in `failed` (start-limit hit), rate-limited (see
# the failed branch below), so a crash-looped start eventually converges back to
# running without a human.
#
# Failure modes this deliberately guards against becoming false positives —
# a watchdog that flaps (restarts on every transient blip) is worse than no
# watchdog at all:
#   - Mid-deploy reload/restart: `evennia reload`/`start` transiently leaves
#     a pidfile stale or briefly regenerates it. We skip entirely while the
#     unit's own sub-state shows a start/reload/restart in flight.
#   - Fresh start: right after (re)start, Evennia daemonizes and (re)writes
#     both pidfiles — that write is not instantaneous. A GRACE_PERIOD_S
#     window after the unit's ActiveEnterTimestamp tolerates a missing
#     pidfile without restarting (which would just race the fresh start).
#
# The SubState string match in the case statement below is best-effort: it's not
# an exhaustive enumeration of every systemd sub-state that could mean "something
# is happening right now", just the ones observed in practice; a sub-state this
# doesn't recognize as "in flight" could still produce a false-positive restart.
set -euo pipefail
set +x

SERVICE="{{ app_service }}.service"
SERVER_PID="{{ app_pidfile }}"
PORTAL_PID="{{ app_portal_pidfile }}"
GRACE_PERIOD_S=120
# Staff @reboot (#4001): the game writes this file, then shuts both daemons
# down the way @shutdown does. The game user cannot touch systemd, and
# Restart=always was rejected (it would turn every deliberate @shutdown into
# a restart), so THIS is what brings the unit back: inactive unit + fresh
# request file = start. The file is deleted before the start so a start that
# fails cannot loop, and a request older than the bound is discarded (a
# forgotten file must never start a game somebody stopped on purpose later).
# Same path as src/evennia_extensions/reboot.py; acceptance.sh checks the two agree.
REBOOT_REQUEST="{{ app_gamedir }}/server/reboot.requested"
REBOOT_REQUEST_MAX_AGE_S=600

log() { printf '[watchdog] %s\n' "$*"; }

# consume_reboot_request: delete the staff reboot request (if any) and print
# "<age in seconds> <requester>" so the caller can log who asked and decide
# whether the request is still fresh. Prints nothing when there is no file.
# Every branch that acts on a non-active unit calls this FIRST, so a request
# is consumed exactly once whichever state the unit landed in; a request left
# behind by the `failed` path would otherwise auto-start the next deliberate
# stop within the age bound.
consume_reboot_request() {
  [ -f "${REBOOT_REQUEST}" ] || return 0
  local now_s request_s requester
  now_s="$(date +%s)"
  request_s="$(stat -c %Y "${REBOOT_REQUEST}" 2>/dev/null || echo 0)"
  requester="$(sed -n 's/^requested_by=//p' "${REBOOT_REQUEST}" 2>/dev/null | head -n1)"
  rm -f "${REBOOT_REQUEST}"
  printf '%s %s\n' "$(( now_s - request_s ))" "${requester:-unknown}"
}

# Three states matter here:
#   active  -> fall through to the half-dead pidfile checks below.
#   failed  -> systemd's Restart= gave up (start-limit hit). Nothing else
#              will ever retry — this was the 2026-08-17 outage: a reboot-
#              time restart race parked the unit in `failed` and the site
#              served 502s until a human pressed the deploy button. Resurrect
#              it here, rate-limited by a stamp file so a genuinely broken
#              build gets one attempt per RESURRECT_INTERVAL_S, not a flap
#              storm (each attempt still gets the unit's own StartLimitBurst
#              of internal retries).
#   other (inactive/activating/...) -> deliberate stop or start in flight;
#              not ours to touch.
RESURRECT_INTERVAL_S=300
RESURRECT_STAMP=/run/arxii-watchdog.resurrect-stamp

active_state="$(systemctl is-active "${SERVICE}" 2>/dev/null || true)"
if [ "${active_state}" != "active" ]; then
  if [ "${active_state}" = "failed" ]; then
    consumed="$(consume_reboot_request)"
    if [ -n "${consumed}" ]; then
      log "unit is failed; a staff reboot request (${consumed#* }, ${consumed%% *}s old) is consumed here and not honoured separately"
    fi
    now_s="$(date +%s)"
    last_s="$(stat -c %Y "${RESURRECT_STAMP}" 2>/dev/null || echo 0)"
    if [ $(( now_s - last_s )) -lt "${RESURRECT_INTERVAL_S}" ]; then
      log "unit failed but last resurrection was $(( now_s - last_s ))s ago" \
        "(< ${RESURRECT_INTERVAL_S}s) — waiting"
      exit 0
    fi
    touch "${RESURRECT_STAMP}"
    log "unit is failed and nothing else will retry — reset-failed + start"
    systemctl reset-failed "${SERVICE}"
    systemctl start "${SERVICE}" || log "start failed; will retry next interval"
    if [ -x /usr/local/sbin/arxii-alert ]; then
      /usr/local/sbin/arxii-alert \
        "watchdog resurrected ${SERVICE} from systemd 'failed' state (start-limit had been hit)"
    fi
    exit 0
  fi
  if [ "${active_state}" = "inactive" ] && [ -f "${REBOOT_REQUEST}" ]; then
    consumed="$(consume_reboot_request)"
    request_age_s="${consumed%% *}"
    requester="${consumed#* }"
    if [ "${request_age_s}" -gt "${REBOOT_REQUEST_MAX_AGE_S}" ]; then
      log "reboot request by ${requester} is ${request_age_s}s old (> ${REBOOT_REQUEST_MAX_AGE_S}s) — discarded, not starting"
      exit 0
    fi
    log "reboot requested by ${requester} from inside the game ${request_age_s}s ago — starting ${SERVICE}"
    systemctl start "${SERVICE}" || log "start failed; the deploy button or a human takes it from here"
    if [ -x /usr/local/sbin/arxii-alert ]; then
      /usr/local/sbin/arxii-alert "watchdog started ${SERVICE} after a staff @reboot request by ${requester}"
    fi
    exit 0
  fi
  # This is also what keeps the pidfile checks below away from a unit that
  # is stopping itself (a staff @reboot, a deploy, an operator's stop):
  # systemd reports every stop sub-state as ActiveState=deactivating, which
  # lands here, never in the "active" path.
  log "unit not active (${active_state}) — nothing to do"
  exit 0
fi

# Mid-deploy guard: ActiveState can read "active" straight through a
# reload; the low-level sub-state is what actually distinguishes "steady
# state" from "something is happening right now".
sub_state="$(systemctl show -p SubState --value "${SERVICE}" 2>/dev/null || true)"
case "${sub_state}" in
  reload|activating|auto-restart|start*)
    log "unit sub-state is '${sub_state}' — deploy/restart in flight, skipping this run"
    exit 0
    ;;
esac

# Grace period since the unit last became active — the two pidfiles are
# written by the forked daemons, not instantaneously at unit-active time.
active_enter="$(systemctl show -p ActiveEnterTimestamp --value "${SERVICE}" 2>/dev/null || true)"
now_s="$(date +%s)"
if [ -n "${active_enter}" ] && [ "${active_enter}" != "n/a" ]; then
  active_enter_s="$(date -d "${active_enter}" +%s 2>/dev/null || echo 0)"
  age_s=$(( now_s - active_enter_s ))
else
  age_s=999999   # unknown timestamp — treat as long-running, no grace
fi

pid_alive() {
  local pidfile="$1" pid
  [ -f "${pidfile}" ] || return 1
  pid="$(cat "${pidfile}" 2>/dev/null || true)"
  [ -n "${pid}" ] || return 1
  kill -0 "${pid}" 2>/dev/null
}

# --- Server-only recovery (#4999) ----------------------------------------------
# A dead Server under a live Portal: players are still connected, so bring back
# the Server alone (ExecReload is arxii-reload, with its own budget, evidence and
# alert) before anything that would drop them. This also catches a staff @reload
# that failed, which never passes through ExecReload at all.
#
# A healthy in-game @reload (about 20 s) and a @shutdown in flight both look like
# this for a moment, hence the re-check, and a stop can land at any point while
# the recovery runs, hence the same check before the restart. Ruled in #4999: a
# full restart is the last resort, and one per RESTART_INTERVAL_S at most, so a
# port that never frees cannot drop players every few minutes. Server-only
# attempts carry on inside that window because they drop nobody.
#
# A manual `evennia sstop` looks identical and comes back too; nothing in this
# repo uses it, and @shutdown and @reboot both stop the Portal as well.
SERVER_RECHECK_S=45
RESTART_INTERVAL_S=900
RESTART_STAMP=/run/arxii-watchdog.restart-stamp

alert() {
  if [ -x /usr/local/sbin/arxii-alert ]; then
    # A failed alert must not fail the run that just repaired the game.
    /usr/local/sbin/arxii-alert "$1" || log "alert could not be sent"
  else
    log "arxii-alert helper not installed yet; skipping off-box alert"
  fi
}

# server_recovery_wanted <portal pid>: the unit is steady, the Server is dead, the
# same Portal is alive, and nobody has asked for a stop or a reboot.
server_recovery_wanted() {
  [ "$(systemctl is-active "${SERVICE}" 2>/dev/null || true)" = "active" ] \
    && [ "$(systemctl show -p SubState --value "${SERVICE}" 2>/dev/null || true)" = "running" ] \
    && [ ! -f "${REBOOT_REQUEST}" ] \
    && ! pid_alive "${SERVER_PID}" \
    && pid_alive "${PORTAL_PID}" \
    && [ "$(cat "${PORTAL_PID}" 2>/dev/null || true)" = "$1" ]
}

if [ "${age_s}" -ge "${GRACE_PERIOD_S}" ] && pid_alive "${PORTAL_PID}" && ! pid_alive "${SERVER_PID}"; then
  portal_pid="$(cat "${PORTAL_PID}")"
  log "Server is dead under a live Portal; re-checking in ${SERVER_RECHECK_S}s"
  sleep "${SERVER_RECHECK_S}"
  if ! server_recovery_wanted "${portal_pid}"; then
    log "no recovery wanted after the re-check (a reload or stop was in flight)"
    exit 0
  fi
  log "recovering the Server alone"
  if systemctl reload "${SERVICE}"; then
    log "Server recovered; Portal ${portal_pid} kept"
    alert "watchdog recovered a dead Server under ${SERVICE}; Portal kept, players stayed connected"
    exit 0
  fi
  if ! server_recovery_wanted "${portal_pid}"; then
    log "reload failed, but the unit is no longer in that state; leaving it alone"
    exit 0
  fi
  now_s="$(date +%s)"
  last_restart_s="$(stat -c %Y "${RESTART_STAMP}" 2>/dev/null || echo 0)"
  if [ $(( now_s - last_restart_s )) -lt "${RESTART_INTERVAL_S}" ]; then
    log "Server-only recovery failed; last full restart was $(( now_s - last_restart_s ))s ago, not restarting again yet"
    alert "${SERVICE}: Server is still down after recovery and a full restart $(( now_s - last_restart_s ))s ago; needs a person if this repeats"
    exit 0
  fi
  touch "${RESTART_STAMP}"
  log "Server-only recovery failed; full restart as the last resort"
  # Alert first: a restart that cannot bring the Server up blocks for minutes.
  alert "watchdog restarting ${SERVICE} after Server-only recovery failed; players drop once"
  # The alert can take seconds; a stop that landed meanwhile must win.
  if ! server_recovery_wanted "${portal_pid}"; then
    log "the unit left that state while alerting; not restarting"
    exit 0
  fi
  systemctl restart "${SERVICE}" || log "restart failed; the failed-state branch retries from here"
  exit 0
fi

dead=0
for pf in "${SERVER_PID}" "${PORTAL_PID}"; do
  if ! pid_alive "${pf}"; then
    if [ "${age_s}" -lt "${GRACE_PERIOD_S}" ]; then
      log "pidfile ${pf} missing/dead but unit started ${age_s}s ago" \
        "(< ${GRACE_PERIOD_S}s grace) — skipping"
      exit 0
    fi
    log "pidfile ${pf} missing or its process is not running"
    dead=1
  fi
done

if [ "${dead}" -ne 1 ]; then
  log "both server.pid and portal.pid processes alive — OK"
  exit 0
fi

log "restarting ${SERVICE} (an Evennia daemon is dead while the unit reports active)"
systemctl restart "${SERVICE}"

# The restart above always happens regardless; only the alert is skipped when the
# helper is missing. Guarded because site.yml runs offbox_alerting AFTER app_deploy:
# on a brand-new box's FIRST converge, this watchdog's own timer could fire before
# /usr/local/sbin/arxii-alert exists, and a bare call would be a spurious "watchdog
# is broken" failure unrelated to the Evennia-daemon-dead condition being reported.
alert "watchdog restarted ${SERVICE}: a dead Evennia daemon was detected"
