    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "@humanfs/node@0": "0.16.8",
      "ajv@6": "6.14.0",
      "brace-expansion@1": "1.1.16",
