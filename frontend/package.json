    "@radix-ui/react-tabs": "^1.2.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.23.26",
